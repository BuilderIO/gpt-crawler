# GPT Crawler Configuration
# Copy this file to .env and fill in your values

# === API Server Configuration ===
API_PORT=5000
API_HOST=localhost
NODE_ENV=development

# === Crawler Configuration ===
MAX_PAGES_TO_CRAWL=45
CRAWLER_URL=https://example.com
CRAWLER_MATCH=https://example.com/**
CRAWLER_SELECTOR=main
CRAWLER_MAX_PAGES=50
CRAWLER_OUTPUT=output.json

# === Authentication Configuration ===
# Basic username/password authentication
CRAWLER_USERNAME=your-username
CRAWLER_PASSWORD=your-password
CRAWLER_LOGIN_URL=https://example.com/login

# === Custom Selectors (Optional) ===
# Use if the default selectors don't work for your site
CRAWLER_USERNAME_SELECTOR=#email
CRAWLER_PASSWORD_SELECTOR=#password
CRAWLER_SUBMIT_SELECTOR=.login-button

# === Success Verification (Optional) ===
# How to verify login was successful
CRAWLER_SUCCESS_SELECTOR=.dashboard
CRAWLER_SUCCESS_TEXT=Welcome back

# === Timing Configuration ===
CRAWLER_POST_LOGIN_DELAY=3000

# === Debug Options ===
CRAWLER_DEBUG=false
CRAWLER_SAVE_COOKIES=true
CRAWLER_COOKIE_FILE=./session-cookies.json

# === Site-Specific Examples ===

# GitHub Private Repository
# GITHUB_USERNAME=your-github-username
# GITHUB_TOKEN=ghp_your_personal_access_token

# Confluence/Atlassian
# ATLASSIAN_EMAIL=user@company.com
# ATLASSIAN_TOKEN=your_app_password

# Notion
# NOTION_EMAIL=user@company.com
# NOTION_PASSWORD=your_password

# API Documentation
# API_TOKEN=your_api_token

# Session Cookies (get from browser dev tools)
# SESSION_COOKIE=abc123def456
# CSRF_TOKEN=xyz789uvw123

# Complex Site with Company Code
# SITE_EMAIL=user@company.com
# SITE_PASSWORD=your_password
# COMPANY_CODE=ABC123
